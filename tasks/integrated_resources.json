{
  "task": [
    {
      "name": "统合资源刷取",
      "entry": "IntegratedResources.Run",
      "default_check": false,
      "group": [
        "Daily"
      ],
      "description": "./resource/announcement/统合资源刷取.md",
      "option": [
        "integrated_team",
        "integrated_categories"
      ]
    }
  ],
  "option": {
    "integrated_team": {
      "type": "select",
      "label": "指定队伍",
      "default_case": "队伍1",
      "description": "所有勾选大类共用这一队伍。按选队界面从上到下的槽位编号1–5选择。",
      "cases": [
        {
          "name": "队伍1",
          "pipeline_override": {
            "IntegratedResources.Run": {
              "action": {
                "param": {
                  "custom_action_param": {
                    "team": 1
                  }
                }
              }
            }
          }
        },
        {
          "name": "队伍2",
          "pipeline_override": {
            "IntegratedResources.Run": {
              "action": {
                "param": {
                  "custom_action_param": {
                    "team": 2
                  }
                }
              }
            }
          }
        },
        {
          "name": "队伍3",
          "pipeline_override": {
            "IntegratedResources.Run": {
              "action": {
                "param": {
                  "custom_action_param": {
                    "team": 3
                  }
                }
              }
            }
          }
        },
        {
          "name": "队伍4",
          "pipeline_override": {
            "IntegratedResources.Run": {
              "action": {
                "param": {
                  "custom_action_param": {
                    "team": 4
                  }
                }
              }
            }
          }
        },
        {
          "name": "队伍5",
          "pipeline_override": {
            "IntegratedResources.Run": {
              "action": {
                "param": {
                  "custom_action_param": {
                    "team": 5
                  }
                }
              }
            }
          }
        }
      ]
    },
    "integrated_categories": {
      "type": "checkbox",
      "label": "指定刷取的大类关卡",
      "description": "勾选大类内的全部小关卡各快速战斗一次；执行不了的跳过并反馈，体力不足停止。",
      "default_case": [
        "特别军费行动",
        "作战体能训练",
        "兵种能力评级",
        "载具对抗演练"
      ],
      "cases": [
        {
          "name": "特别军费行动",
          "pipeline_override": {
            "IntegratedResources.Category.funds": {
              "enabled": true
            }
          }
        },
        {
          "name": "作战体能训练",
          "pipeline_override": {
            "IntegratedResources.Category.physical": {
              "enabled": true
            }
          }
        },
        {
          "name": "兵种能力评级",
          "pipeline_override": {
            "IntegratedResources.Category.rating": {
              "enabled": true
            }
          }
        },
        {
          "name": "载具对抗演练",
          "pipeline_override": {
            "IntegratedResources.Category.vehicle": {
              "enabled": true
            }
          }
        }
      ]
    }
  }
}
